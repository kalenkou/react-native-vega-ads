{
  "name": "@vega-ads/demo",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "jest --colors ",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src test --ext .ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src test --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release --build-number 1",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "use-core": "npm run build --prefix ../../packages/core && npm run build --prefix ../../packages/vega && mkdir -p .tmp && npm pack ../../packages/core ../../packages/vega --pack-destination .tmp && npm install --no-save .tmp/react-native-ads-core-0.1.3.tgz .tmp/react-native-vega-ads-0.1.3.tgz"
  },
  "dependencies": {
    "@amazon-devices/kepler-a11y-settings-interface-turbo": "1.0.0",
    "@amazon-devices/kepler-adid-retriever": "^1.0.18",
    "@amazon-devices/kepler-performance-api": "^0.1.4",
    "@amazon-devices/react-native-async-storage__async-storage": "2.1.9000000001",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3",
    "mustache": "^4.2.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "vegaAdsDemo",
    "targets": [
      "tv"
    ]
  },
  "description": "Demo app: a movie with ads that do not annoy, on Vega OS",
  "overrides": {
    "logkitty": "^0.7.1",
    "shell-quote": "^1.8.5"
  }
}
